#!/bin/bash
set -euo pipefail

DB="${OPENCODE_DB:-${XDG_DATA_HOME:-${HOME}/.local/share}/opencode/opencode.db}"
INDEX_DB="${SESH_INDEX_DB:-${XDG_CACHE_HOME:-${HOME}/.cache}/sesh/index.db}"


usage() {
  cat <<EOF
sesh - Global session search for OpenCode

Usage:
  sesh list [n] [--json] [--verbose] [--native-v2]
                                      List n recent sessions (default: 10)
  sesh search <query> [options]     Search sessions globally by title/directory/message
  sesh index [--rebuild]            Build or rebuild the local search index
  sesh show <id>                    Show full session details
  sesh log <id> [options]           Show user + assistant text log
  sesh prompts <id> [options]       Show user prompts only
  sesh resume <id>                  Print command to resume a session
  sesh move <id> <target-project-dir> [--dry-run|--apply]
                                      Move a session to an existing project
  sesh today                        Sessions active in the last 24 hours
  sesh stats                        Aggregate session statistics
  sesh files <id>                   List files touched in a session
  sesh config                       Show configuration and env
  sesh help                         Show this help

Search options:
  --content                   Search message content too (default)
  --title, --no-content       Search title and directory only
  --since <date>              Filter by start date (ISO 8601 or '7d', '30d')
  --until <date>              Filter by end date
  --limit <n>                 Max results (default: 20)
  --fuzzy                     Broader substring matching
  --no-index                  Skip the local search index and use LIKE matching
  --json                      Output in JSON format (pipe to jq, fzf)
  --verbose                   Include OpenCode subagent sessions
Log/prompts options:
  --limit <n>                 Max messages (default: 50)
  --full                      Show full message text (default)
Move options:
  --dry-run                   Preview the move without writing (default)
  --apply                     Back up the DB, then update the session
Environment:
  OPENCODE_DB                 Path to opencode.db (default: ~/.local/share/opencode/opencode.db)
  SESH_INDEX_DB               Path to the local search index (default: ~/.cache/sesh/index.db)
  SESH_BIN                    Path to sesh binary (for plugin, not CLI)
Examples:
  sesh search justfile
  sesh search hyperswitch --since 7d --limit 5
  sesh search justfile --title
  sesh index --rebuild
  sesh show ses_xxxxxxxxxxxxxxxxxxxx
  sesh log ses_xxxxxxxxxxxxxxxxxxxx
  sesh prompts ses_xxxxxxxxxxxxxxxxxxxx --full
  sesh resume ses_xxxxxxxxxxxxxxxxxxxx
  sesh move ses_xxxxxxxxxxxxxxxxxxxx /path/to/project --apply
  sesh search justfile --json | jq '.[].title'
  sesh files ses_xxxxxxxxxxxxxxxxxxxx
EOF
}

if [[ ! -f "$DB" ]]; then
  echo "Error: Database not found at $DB" >&2
  echo "Set OPENCODE_DB env var to specify a different path" >&2
  exit 1
fi

# Build connection-local, read-only projections. Never modify the host schema.
HAS_V2=$(sqlite3 "$DB" "PRAGMA query_only=ON; SELECT count(*) FROM sqlite_master WHERE type='table' AND name IN ('session_v2','session_message');")
HAS_V1=$(sqlite3 "$DB" "PRAGMA query_only=ON; SELECT count(*) FROM sqlite_master WHERE type='table' AND name IN ('session','message','part');")
# A migrated database often keeps empty legacy tables. Probe once for legacy-only
# sessions so the expensive mixed projection is skipped when nothing needs it.
if [[ "$HAS_V2" == 2 && "$HAS_V1" == 3 ]]; then
  LEGACY_SESSIONS=$(sqlite3 "$DB" "PRAGMA query_only=ON; SELECT EXISTS(SELECT 1 FROM main.session s WHERE NOT EXISTS (SELECT 1 FROM main.session_v2 v WHERE v.id=s.id));")
  if [[ "$LEGACY_SESSIONS" == 0 ]]; then
    HAS_V1=0
  fi
fi
READ_SCHEMA=""
if [[ "$HAS_V2" == 2 ]]; then
  READ_SCHEMA=$(cat <<'SQL'
CREATE TEMP VIEW session AS
SELECT id,project_id,parent_id,directory,title,version,agent,model,cost,tokens_input,tokens_output,
       tokens_reasoning,tokens_cache_read,tokens_cache_write,time_created,time_updated
FROM main.session_v2;
CREATE TEMP VIEW message AS
SELECT id,session_id,time_created,seq AS transcript_order,
       json_set(data,'$.role',type,'$.modelID',json_extract(data,'$.model.id'),
         '$.providerID',json_extract(data,'$.model.providerID'),
         '$.tokens.total',CASE WHEN json_type(data,'$.tokens')='object' THEN
           COALESCE(json_extract(data,'$.tokens.input'),0)+COALESCE(json_extract(data,'$.tokens.output'),0)+
           COALESCE(json_extract(data,'$.tokens.reasoning'),0)+COALESCE(json_extract(data,'$.tokens.cache.read'),0)+
           COALESCE(json_extract(data,'$.tokens.cache.write'),0) END) AS data
FROM main.session_message WHERE type IN ('user','assistant');
CREATE TEMP VIEW part AS
SELECT id || ':text' AS id,id AS message_id,session_id,0 AS part_order,
       json_object('type','text','text',json_extract(data,'$.text')) AS data
FROM main.session_message WHERE type='user'
UNION ALL
SELECT m.id || ':text:' || c.key,m.id,m.session_id,CAST(c.key AS INTEGER),c.value
FROM main.session_message m,json_each(m.data,'$.content') c
WHERE m.type='assistant' AND json_extract(c.value,'$.type')='text';
CREATE TEMP VIEW session_file AS
SELECT m.session_id,f.value AS file
FROM main.session_message m,json_each(m.data,'$.snapshot.files') f WHERE m.type='assistant';
SQL
)
  if [[ "$HAS_V1" == 3 ]]; then
    # The v2 migration retains legacy rows. Include only sessions not migrated yet.
    READ_SCHEMA=$(cat <<'SQL'
CREATE TEMP VIEW selected_legacy AS SELECT * FROM main.session s
WHERE NOT EXISTS (SELECT 1 FROM main.session_v2 v WHERE v.id=s.id);
CREATE TEMP VIEW session AS
SELECT id,project_id,parent_id,directory,title,version,agent,model,cost,tokens_input,tokens_output,
       tokens_reasoning,tokens_cache_read,tokens_cache_write,time_created,time_updated FROM main.session_v2
UNION ALL
SELECT id,project_id,parent_id,directory,title,version,agent,model,cost,tokens_input,tokens_output,
       tokens_reasoning,tokens_cache_read,tokens_cache_write,time_created,time_updated FROM selected_legacy;
CREATE TEMP VIEW message AS
SELECT id,session_id,time_created,seq AS transcript_order,
       json_set(data,'$.role',type,'$.modelID',json_extract(data,'$.model.id'),
         '$.providerID',json_extract(data,'$.model.providerID'),
         '$.tokens.total',CASE WHEN json_type(data,'$.tokens')='object' THEN
           COALESCE(json_extract(data,'$.tokens.input'),0)+COALESCE(json_extract(data,'$.tokens.output'),0)+
           COALESCE(json_extract(data,'$.tokens.reasoning'),0)+COALESCE(json_extract(data,'$.tokens.cache.read'),0)+
           COALESCE(json_extract(data,'$.tokens.cache.write'),0) END) AS data
FROM main.session_message WHERE type IN ('user','assistant')
UNION ALL
SELECT m.id,m.session_id,m.time_created,m.time_created,m.data FROM main.message m
JOIN selected_legacy s ON s.id=m.session_id;
CREATE TEMP VIEW part AS
SELECT id || ':text' AS id,id AS message_id,session_id,0 AS part_order,
       json_object('type','text','text',json_extract(data,'$.text')) AS data
FROM main.session_message WHERE type='user'
UNION ALL
SELECT m.id || ':text:' || c.key,m.id,m.session_id,CAST(c.key AS INTEGER),c.value
FROM main.session_message m,json_each(m.data,'$.content') c
WHERE m.type='assistant' AND json_extract(c.value,'$.type')='text'
UNION ALL
SELECT p.id,p.message_id,p.session_id,p.rowid,p.data FROM main.part p JOIN selected_legacy s ON s.id=p.session_id;
CREATE TEMP VIEW session_file AS
SELECT m.session_id,f.value AS file FROM main.session_message m,json_each(m.data,'$.snapshot.files') f
WHERE m.type='assistant'
UNION ALL
SELECT m.session_id,json_extract(f.value,'$.file') FROM main.message m
JOIN selected_legacy s ON s.id=m.session_id,json_each(m.data,'$.summary.diffs') f;
SQL
)
  fi
elif [[ "$HAS_V1" == 3 ]]; then
  READ_SCHEMA=$(cat <<'SQL'
CREATE TEMP VIEW message AS SELECT *,time_created AS transcript_order FROM main.message;
CREATE TEMP VIEW part AS SELECT *,rowid AS part_order FROM main.part;
CREATE TEMP VIEW session_file AS
SELECT m.session_id,json_extract(f.value,'$.file') AS file FROM main.message m,json_each(m.data,'$.summary.diffs') f;
SQL
)
else
  echo "Error: unsupported OpenCode schema at $DB" >&2
  exit 1
fi

read_db() {
  local sql="${!#}"
  set -- "${@:1:$(($#-1))}"
  # Some SQLite builds cannot reopen a WAL database with -readonly after its
  # shared-memory file is removed. query_only protects all reads without losing WAL data.
  sqlite3 "$@" "$DB" "${READ_SCHEMA} PRAGMA query_only=ON; PRAGMA cache_size=-262144; ${sql}"
}

escape_sql() {
  printf '%s' "$1" | sed "s/'/''/g"
}

resolve_path() {
  local input="$1"
  local resolved
  if resolved="$(realpath "$input" 2>/dev/null)"; then
    printf '%s' "$resolved"
  else
    printf '%s' "$input"
  fi
}

create_db_backup() {
  local timestamp
  timestamp="$(date +%Y%m%d-%H%M%S)"
  local backup="${DB}.sesh-backup-${timestamp}"
  if [[ -e "$backup" ]]; then
    backup="${backup}-$$"
  fi
  local escaped_backup
  escaped_backup="$(escape_sql "$backup")"

  if ! sqlite3 "$DB" "VACUUM INTO '${escaped_backup}';"; then
    echo "Error: failed to create backup at ${backup}" >&2
    rm -f "$backup"
    exit 1
  fi

  printf '%s\n' "$backup"
}

ensure_project_worktree_column() {
  local has_worktree
  has_worktree=$(sqlite3 "$DB" "SELECT count(*) FROM pragma_table_info('project') WHERE name = 'worktree';" 2>/dev/null)
  if [[ "$has_worktree" != "1" ]]; then
    echo "Error: unsupported OpenCode schema: project.worktree column not found" >&2
    exit 1
  fi
}

ensure_session_exists() {
  local sid="$1"
  local exists
   exists=$(read_db "SELECT count(*) FROM session WHERE id = '${sid}';" 2>/dev/null)
  if [[ "$exists" -eq 0 ]]; then
    echo "Error: session not found: ${sid}" >&2
    exit 1
  fi
}

session_filter_clause() {
  local alias="$1"
  local verbose="$2"
  if (( verbose )); then
    echo "1=1"
  else
    local native_filter=""
    if [[ "$HAS_V2" == 2 ]]; then
      native_filter="AND (${alias}.parent_id IS NULL OR NOT EXISTS (SELECT 1 FROM main.session_v2 native WHERE native.id=${alias}.id))"
    fi
    echo "COALESCE(${alias}.title, '') NOT LIKE '%(@% subagent)%' ${native_filter}"
  fi
}

time_ago() {
  local epoch="$1"
  local now
  now=$(date +%s)
  local diff=$(( now - epoch ))
  if (( diff < 60 )); then
    echo "${diff}s"
  elif (( diff < 3600 )); then
    echo "$(( diff / 60 ))m"
  elif (( diff < 86400 )); then
    echo "$(( diff / 3600 ))h"
  else
    echo "$(( diff / 86400 ))d"
  fi
}

parse_date() {
  local val="$1"
  if [[ -z "$val" ]]; then
    echo ""
    return
  fi
  if [[ "$val" =~ ^([0-9]+)([dDhHmM])$ ]]; then
    local num="${BASH_REMATCH[1]}"
    local unit="${BASH_REMATCH[2]}"
    case "$unit" in
      d|D) date -v -"${num}"d +%s 2>/dev/null || date -d "${num} days ago" +%s 2>/dev/null;;
      h|H) date -v -"${num}"H +%s 2>/dev/null || date -d "${num} hours ago" +%s 2>/dev/null;;
      m|M) date -v -"${num}"M +%s 2>/dev/null || date -d "${num} minutes ago" +%s 2>/dev/null;;
    esac
    return
  fi
  if echo "$val" | grep -qE '^[0-9]{4}-[0-9]{2}-[0-9]{2}'; then
    if [[ "$val" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}T ]]; then
      date -j -f "%Y-%m-%dT%H:%M:%S" "$val" +%s 2>/dev/null || \
      date -d "$val" +%s 2>/dev/null || echo ""
    else
      date -j -f "%Y-%m-%d" "$val" +%s 2>/dev/null || \
      date -d "$val" +%s 2>/dev/null || echo ""
    fi
    return
  fi
  echo ""
}

# --- Local FTS5 search index -------------------------------------------------
# The sidecar index lets `sesh search` avoid scanning message content. It is
# only used for v2-only databases, and every index failure falls back to LIKE.

index_sync() {
  local quiet="${1:-0}"
  local target="${2:-$INDEX_DB}"
  local escaped_db uri_db sql stamp existing_stamp
  escaped_db="$(escape_sql "$DB")"
  # The stamp covers the index format version, the tokenizer, and the source
  # database. A mismatch discards the index and rebuilds it from scratch.
  stamp="1:trigram:${escaped_db}"
  # ATTACH the source database through a read-only URI. Percent-encode the
  # characters that would otherwise be parsed as URI delimiters.
  uri_db="${DB//%/%25}"
  uri_db="${uri_db//\?/%3F}"
  uri_db="${uri_db//#/%23}"
  uri_db="$(escape_sql "$uri_db")"

  mkdir -p "$(dirname "$target")" 2>/dev/null || return 1

  if [[ -f "$target" ]]; then
    existing_stamp=$(sqlite3 "$target" "SELECT value FROM meta WHERE key='stamp';" 2>/dev/null || true)
    if [[ "$existing_stamp" != "$stamp" ]]; then
      rm -f "$target" "$target-wal" "$target-shm"
    fi
  fi

  sql=$(cat <<SQL
PRAGMA busy_timeout=5000;
CREATE VIRTUAL TABLE IF NOT EXISTS search_fts USING fts5(session_id UNINDEXED, source UNINDEXED, text, tokenize='trigram');
CREATE TABLE IF NOT EXISTS sync_state(session_id TEXT PRIMARY KEY, time_updated INTEGER NOT NULL);
CREATE TABLE IF NOT EXISTS meta(key TEXT PRIMARY KEY, value TEXT NOT NULL);
ATTACH DATABASE 'file:${uri_db}?mode=ro' AS src;
INSERT OR REPLACE INTO meta(key,value) VALUES('stamp','${stamp}');
CREATE TEMP TABLE to_sync AS
SELECT s.id AS id, COALESCE(s.time_updated,0) AS time_updated
FROM src.session_v2 s
LEFT JOIN sync_state st ON st.session_id = s.id
WHERE st.session_id IS NULL OR COALESCE(s.time_updated,0) > st.time_updated;
DELETE FROM search_fts WHERE session_id IN (SELECT id FROM to_sync);
INSERT INTO search_fts(session_id, source, text)
SELECT id, 'title', COALESCE(title, '') FROM src.session_v2 WHERE id IN (SELECT id FROM to_sync);
INSERT INTO search_fts(session_id, source, text)
SELECT id, 'directory', COALESCE(directory, '') FROM src.session_v2 WHERE id IN (SELECT id FROM to_sync);
INSERT INTO search_fts(session_id, source, text)
SELECT m.session_id, 'message', COALESCE(json_extract(m.data, '\$.text'), '')
FROM src.session_message m
WHERE m.type = 'user' AND m.session_id IN (SELECT id FROM to_sync);
INSERT INTO search_fts(session_id, source, text)
SELECT m.session_id, 'message', COALESCE(json_extract(c.value, '\$.text'), '')
FROM src.session_message m, json_each(m.data, '\$.content') c
WHERE m.type = 'assistant' AND json_extract(c.value, '\$.type') = 'text'
  AND m.session_id IN (SELECT id FROM to_sync);
INSERT OR REPLACE INTO sync_state(session_id, time_updated) SELECT id, time_updated FROM to_sync;
DELETE FROM search_fts WHERE session_id NOT IN (SELECT id FROM src.session_v2);
DELETE FROM sync_state WHERE session_id NOT IN (SELECT id FROM src.session_v2);
SQL
)

  if (( quiet )); then
    sqlite3 "$target" "$sql" >/dev/null 2>/dev/null
  else
    sqlite3 "$target" "$sql" >/dev/null
  fi
}

# Build a fresh index into a temp file and swap it in, so an interrupted
# build never leaves a corrupt index behind.
index_build_atomic() {
  local quiet="${1:-0}"
  local tmp="${INDEX_DB}.tmp"
  rm -f "$tmp" "$tmp-wal" "$tmp-shm"
  if ! index_sync "$quiet" "$tmp"; then
    rm -f "$tmp" "$tmp-wal" "$tmp-shm"
    return 1
  fi
  mv "$tmp" "$INDEX_DB"
  rm -f "$tmp-wal" "$tmp-shm"
}

index_query_eligible() {
  local query="$1"
  local fuzzy="$2"
  local words=() word
  if (( fuzzy )); then
    IFS=' ' read -ra words <<< "$query"
  else
    words=("$query")
  fi
  if (( ${#words[@]} == 0 )); then
    return 1
  fi
  for word in "${words[@]}"; do
    if (( ${#word} >= 3 )); then
      return 0
    fi
  done
  return 1
}

index_match_expr() {
  local query="$1"
  local fuzzy="$2"
  local words=() word escaped_word expr=""
  if (( fuzzy )); then
    IFS=' ' read -ra words <<< "$query"
  else
    words=("$query")
  fi
  if (( ${#words[@]} == 0 )); then
    printf '%s' '""'
    return
  fi
  for word in "${words[@]}"; do
    [[ -z "$word" ]] && continue
    escaped_word="${word//\"/\"\"}"
    if [[ -z "$expr" ]]; then
      expr="\"${escaped_word}\""
    else
      expr="${expr} OR \"${escaped_word}\""
    fi
  done
  printf '%s' "$expr"
}

index_search_ids() {
  local query="$1"
  local fuzzy="$2"
  local match_expr match_sql
  match_expr="$(index_match_expr "$query" "$fuzzy")"
  match_sql="$(escape_sql "$match_expr")"
  sqlite3 "$INDEX_DB" "SELECT DISTINCT session_id FROM search_fts WHERE search_fts MATCH '${match_sql}' LIMIT 500;" 2>/dev/null
}

format_session_row() {
  local id="$1"
  local dir="$2"
  local title="$3"

  local short_id="${id:0:12}..."

  local short_dir
  short_dir=$(basename "$dir" 2>/dev/null || echo "$dir")
  if [[ ${#short_dir} -gt 28 ]]; then
    short_dir="${short_dir:0:25}..."
  fi

  if [[ ${#title} -gt 55 ]]; then
    title="${title:0:52}..."
  fi

  printf "%-14s %-30s %-55s\n" "$short_id" "$short_dir" "$title"
}

cmd_list() {
  local limit=10
  local json_output=0
  local verbose=0
  local native_v2=0

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json) json_output=1; shift;;
      --verbose) verbose=1; shift;;
      --native-v2) native_v2=1; shift;;
      -h|--help) usage; exit 0;;
      -*)
        echo "Error: Unknown option: $1" >&2
        exit 1
        ;;
      *)
        if [[ "$1" =~ ^[0-9]+$ ]]; then
          limit="$1"
          shift
        else
          echo "Error: limit must be a positive number" >&2
          exit 1
        fi
        ;;
    esac
  done

  if [[ ! "$limit" =~ ^[0-9]+$ ]] || [[ "$limit" -lt 1 ]]; then
    echo "Error: limit must be a positive number" >&2
    exit 1
  fi

  local sql
  local session_filter
  session_filter="$(session_filter_clause s "$verbose")"
  local inventory=session
  local message_count="(SELECT count(*) FROM main.message m WHERE m.session_id = s.id)"
  if [[ "$HAS_V2" == 2 ]]; then
    message_count="(SELECT count(*) FROM main.session_message m WHERE m.session_id=s.id AND m.type IN ('user','assistant'))"
    if [[ "$HAS_V1" == 3 ]]; then
      message_count="CASE WHEN EXISTS (SELECT 1 FROM main.session_v2 v WHERE v.id=s.id) THEN $message_count ELSE (SELECT count(*) FROM main.message m WHERE m.session_id=s.id) END"
    fi
  fi
  if (( native_v2 )); then
    if [[ "$HAS_V2" != 2 ]]; then
      printf 'Error: native v2 sessions are unavailable in this database\n' >&2
      exit 1
    fi
    inventory=main.session_v2
  fi
  sql="
    SELECT s.id,
           s.directory,
           s.title,
           datetime(s.time_created/1000,'unixepoch') as created,
           datetime(s.time_updated/1000,'unixepoch') as updated,
           $message_count as message_count
    FROM $inventory s
    WHERE ${session_filter}
    ORDER BY s.time_created DESC
    LIMIT $limit;
  "

  if (( json_output )); then
    read_db -json "$sql"
  else
    read_db -header -column "$sql"
  fi
}

cmd_search() {
  local query=""
  local search_content=1
  local since=""
  local until=""
  local limit=20
  local fuzzy=0
  local json_output=0
  local verbose=0
  local use_index=1

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --content) search_content=1; shift;;
      --title|--no-content) search_content=0; shift;;
      --no-index) use_index=0; shift;;
      --since|--after)
        if [[ $# -lt 2 ]]; then
          echo "Error: $1 requires a value" >&2
          exit 1
        fi
        since="$2"
        shift 2
        ;;
      --until|--before)
        if [[ $# -lt 2 ]]; then
          echo "Error: $1 requires a value" >&2
          exit 1
        fi
        until="$2"
        shift 2
        ;;
      --limit)
        if [[ $# -lt 2 ]]; then
          echo "Error: --limit requires a value" >&2
          exit 1
        fi
        limit="$2"
        shift 2
        ;;
      --fuzzy) fuzzy=1; shift;;
      --json) json_output=1; shift;;
      --verbose) verbose=1; shift;;
      -h|--help) usage; exit 0;;
      -*)
        echo "Error: Unknown option: $1" >&2
        usage >&2; exit 1;;
      *)
        if [[ -z "$query" ]]; then
          query="$1"
        fi
        shift;;
    esac
  done

  if [[ -z "$query" ]]; then
    echo "Error: search requires a query argument" >&2
    echo "Usage: sesh search <query> [--since 7d] [--until 2026-06-01] [--limit 20]" >&2
    exit 1
  fi

  if [[ ! "$limit" =~ ^[0-9]+$ ]] || [[ "$limit" -lt 1 ]]; then
    echo "Error: limit must be a positive number" >&2
    exit 1
  fi

  local escaped
  escaped="$(escape_sql "$query")"

  local where_clause=""

  # Prefer the sidecar FTS5 index on v2-only databases. Any failure falls
  # through to the LIKE scan below.
  if (( use_index && search_content )) && [[ "$HAS_V2" == 2 && "$HAS_V1" == 0 ]] && index_query_eligible "$query" "$fuzzy"; then
    if [[ ! -f "$INDEX_DB" ]]; then
      echo "sesh: building search index (one-time)…" >&2
      index_build_atomic 1 || true
    fi
    local index_ids=""
    if index_sync 1 && index_ids="$(index_search_ids "$query" "$fuzzy")"; then
      if [[ -z "$index_ids" ]]; then
        where_clause="0"
      else
        local index_id_list="" index_id
        while IFS= read -r index_id; do
          [[ -z "$index_id" ]] && continue
          index_id_list="${index_id_list}'$(escape_sql "$index_id")',"
        done <<< "$index_ids"
        if [[ -z "$index_id_list" ]]; then
          where_clause="0"
        else
          where_clause="s.id IN (${index_id_list%,})"
        fi
      fi
    fi
  fi

  if [[ -z "$where_clause" ]]; then
    local wildcard="%"
    local query_pattern="${wildcard}${escaped}${wildcard}"

    if (( fuzzy )); then
      # Fuzzy: match each word independently
      local words
      IFS=' ' read -ra words <<< "$escaped"
      local fuzzy_conditions=()
      for word in "${words[@]}"; do
        fuzzy_conditions+=("(s.title LIKE '%${word}%' OR s.directory LIKE '%${word}%')")
      done
      local title_dir_condition="${fuzzy_conditions[0]}"
      local i
      for ((i = 1; i < ${#fuzzy_conditions[@]}; i++)); do
        title_dir_condition="${title_dir_condition} OR ${fuzzy_conditions[$i]}"
      done

      where_clause="$title_dir_condition"

      if (( search_content )); then
        local part_conditions=()
        for word in "${words[@]}"; do
          part_conditions+=("json_extract(p.data, '$.text') LIKE '%${word}%'")
        done
        local part_condition="${part_conditions[0]}"
        for ((i = 1; i < ${#part_conditions[@]}; i++)); do
          part_condition="${part_condition} OR ${part_conditions[$i]}"
        done
        where_clause="($where_clause OR EXISTS (SELECT 1 FROM part p WHERE p.session_id = s.id AND json_extract(p.data, '$.type') = 'text' AND ($part_condition)))"
      fi
    else
      where_clause="(s.title LIKE '${query_pattern}' OR s.directory LIKE '${query_pattern}')"

      if (( search_content )); then
        where_clause="($where_clause OR EXISTS (SELECT 1 FROM part p WHERE p.session_id = s.id AND json_extract(p.data, '$.type') = 'text' AND json_extract(p.data, '$.text') LIKE '${query_pattern}'))"
      fi
    fi
  fi

  local date_condition=""
  if [[ -n "$since" ]]; then
    local since_ts
    since_ts=$(parse_date "$since")
    if [[ -n "$since_ts" ]]; then
      date_condition=" AND s.time_created >= $((since_ts * 1000))"
    fi
  fi
  if [[ -n "$until" ]]; then
    local until_ts
    until_ts=$(parse_date "$until")
    if [[ -n "$until_ts" ]]; then
      date_condition="${date_condition} AND s.time_created <= $((until_ts * 1000))"
    fi
  fi

  local sql
  local session_filter
  session_filter="$(session_filter_clause s "$verbose")"
  sql="SELECT s.id, s.directory, s.title, datetime(s.time_created/1000,'unixepoch') as created, datetime(s.time_updated/1000,'unixepoch') as updated
FROM session s
WHERE (${where_clause}) AND ${session_filter}${date_condition}
ORDER BY s.time_created DESC
LIMIT $limit;"

  if (( json_output )); then
    local json_result
    json_result="$(read_db -json "$sql")"
    if [[ -z "$json_result" ]]; then
      printf '[]\n'
    else
      printf '%s\n' "$json_result"
    fi
  else
    read_db -header -column "$sql"
  fi
}

cmd_index() {
  local rebuild=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --rebuild) rebuild=1; shift;;
      -h|--help)
        echo "Usage: sesh index [--rebuild]"
        exit 0
        ;;
      *)
        echo "Error: Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ "$HAS_V2" != 2 || "$HAS_V1" != 0 ]]; then
    echo "Error: index requires a v2-only OpenCode database" >&2
    exit 1
  fi

  local start end elapsed sessions
  start=$(date +%s)

  if (( rebuild )) || [[ ! -f "$INDEX_DB" ]]; then
    if ! index_build_atomic 0; then
      echo "Error: failed to build search index at ${INDEX_DB}" >&2
      exit 1
    fi
  elif ! index_sync 0; then
    echo "Error: failed to build search index at ${INDEX_DB}" >&2
    exit 1
  fi

  sessions=$(sqlite3 "$INDEX_DB" "SELECT count(*) FROM sync_state;" 2>/dev/null || echo 0)
  end=$(date +%s)
  elapsed=$(( end - start ))

  echo "Indexed ${sessions} sessions in ${elapsed}s"
  echo "Index: ${INDEX_DB}"
}

cmd_show() {
  local sid="$1"
  if [[ -z "$sid" ]]; then
    echo "Error: show requires a session ID" >&2
    exit 1
  fi
  sid="$(escape_sql "$sid")"
  ensure_session_exists "$sid"

  echo "Session details"

  read_db -separator $'\n' "
    SELECT 'ID:        ' || s.id,
           'Title:     ' || s.title,
           'Directory: ' || s.directory,
           'Created:   ' || datetime(s.time_created/1000,'unixepoch'),
           'Updated:   ' || datetime(s.time_updated/1000,'unixepoch'),
           'Agent:     ' || COALESCE(s.agent, 'N/A'),
           'Model:     ' || COALESCE(s.model, 'N/A'),
           'Version:   ' || s.version,
           'Project:   ' || COALESCE(p.name, s.project_id),
           'Cost:      ' || printf('%.4f', s.cost),
           'Tokens (I/O/R): ' || s.tokens_input || ' / ' || s.tokens_output || ' / ' || COALESCE(s.tokens_reasoning, 0),
           'Cache (R/W): ' || COALESCE(s.tokens_cache_read, 0) || ' / ' || COALESCE(s.tokens_cache_write, 0)
    FROM session s
    LEFT JOIN project p ON p.id = s.project_id
    WHERE s.id = '${sid}';
  " 2>/dev/null

  local msg_count
  msg_count=$(read_db "SELECT count(*) FROM message WHERE session_id = '${sid}';" 2>/dev/null)
  local user_msgs
  user_msgs=$(read_db "SELECT count(*) FROM message WHERE session_id = '${sid}' AND json_extract(data,'$.role')='user';" 2>/dev/null)
  local assistant_msgs
  assistant_msgs=$(read_db "SELECT count(*) FROM message WHERE session_id = '${sid}' AND json_extract(data,'$.role')='assistant';" 2>/dev/null)

  echo "Messages:    $msg_count total ($user_msgs user, $assistant_msgs assistant)"

  echo ""
  echo "Messages"
  read_db -separator $'\n' "
    WITH text_parts AS (
      SELECT message_id,
             replace(group_concat(json_extract(data, '$.text'), ' '), char(10), ' ') AS text
      FROM (SELECT * FROM part ORDER BY part_order)
      WHERE session_id = '${sid}' AND json_extract(data, '$.type') = 'text'
      GROUP BY message_id
    )
    SELECT CASE
      WHEN json_extract(m.data,'$.role') = 'user' THEN
        '[USER]      ' || COALESCE(NULLIF(substr(tp.text, 1, 180), ''), COALESCE(json_extract(m.data,'$.summary.title'), '(no text)'))
      WHEN json_extract(m.data,'$.role') = 'assistant' THEN
        '[ASSISTANT] ' || COALESCE(NULLIF(substr(tp.text, 1, 180), ''), CASE
          WHEN json_extract(m.data,'$.finish') = 'stop' THEN 'completed'
          WHEN json_extract(m.data,'$.finish') = 'tool-calls' THEN 'tool calls'
          WHEN json_extract(m.data,'$.error') IS NOT NULL THEN 'error'
          ELSE 'unknown'
        END) || ' | model: ' || COALESCE(json_extract(m.data,'$.modelID'), '?') || ' | tokens: ' || COALESCE(json_extract(m.data,'$.tokens.total'), '?')
      ELSE '[OTHER]    ' || json_extract(m.data,'$.role')
    END,
    '            ' || datetime(m.time_created/1000,'unixepoch') || ' (' || CAST(m.time_created AS TEXT) || ')'
    FROM message m
    LEFT JOIN text_parts tp ON tp.message_id = m.id
    WHERE m.session_id = '${sid}'
    ORDER BY m.transcript_order ASC;
  " 2>/dev/null

  echo ""
  echo "Files changed"
  local file_count
  file_count=$(read_db "
    SELECT count(DISTINCT file) FROM session_file WHERE session_id = '${sid}';
  " 2>/dev/null)

  if [[ "$file_count" -gt 0 ]]; then
    read_db -separator $'\n' "
      SELECT DISTINCT '- ' || file FROM session_file WHERE session_id = '${sid}' ORDER BY file;
    " 2>/dev/null
  else
    echo "(none)"
  fi
}

cmd_messages() {
  local mode="$1"
  local sid="${2:-}"
  shift 2 || true

  if [[ -z "$sid" ]]; then
    echo "Error: ${mode} requires a session ID" >&2
    exit 1
  fi

  local limit=50
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --limit)
        if [[ $# -lt 2 ]]; then
          echo "Error: --limit requires a value" >&2
          exit 1
        fi
        limit="$2"
        shift 2
        ;;
      --full) shift;;
      -h|--help)
        echo "Usage: sesh ${mode} <session_id> [--limit n] [--full]"
        exit 0
        ;;
      *)
        echo "Error: Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  if [[ ! "$limit" =~ ^[0-9]+$ ]] || [[ "$limit" -lt 1 ]]; then
    echo "Error: limit must be a positive number" >&2
    exit 1
  fi

  sid="$(escape_sql "$sid")"
  ensure_session_exists "$sid"

  local role_filter=""
  local heading="Session log"
  if [[ "$mode" == "prompts" ]]; then
    role_filter="AND json_extract(m.data, '$.role') = 'user'"
    heading="User prompts"
  fi

  echo "${heading} for ${sid}"
  echo ""

  local text_expr
  text_expr="replace(COALESCE(tp.text, ''), char(10), '\\n')"

  read_db -separator $'\t' "
    WITH text_parts AS (
      SELECT message_id,
             group_concat(json_extract(data, '$.text'), char(10) || char(10)) AS text
      FROM (SELECT * FROM part ORDER BY part_order)
      WHERE session_id = '${sid}' AND json_extract(data, '$.type') = 'text'
      GROUP BY message_id
    )
    SELECT upper(COALESCE(json_extract(m.data, '$.role'), 'unknown')),
           datetime(m.time_created/1000,'unixepoch'),
           ${text_expr}
    FROM message m
    LEFT JOIN text_parts tp ON tp.message_id = m.id
    WHERE m.session_id = '${sid}' ${role_filter}
      AND COALESCE(tp.text, '') <> ''
    ORDER BY m.transcript_order ASC
    LIMIT $limit;
  " 2>/dev/null | while IFS=$'\t' read -r role created text; do
    if [[ -n "$text" ]]; then
      echo "[$role] $created"
      echo "$text"
      echo ""
    fi
  done
}

cmd_resume() {
  local sid="$1"
  if [[ -z "$sid" ]]; then
    echo "Error: resume requires a session ID" >&2
    exit 1
  fi
  sid="$(escape_sql "$sid")"
  ensure_session_exists "$sid"

  echo "opencode -s ${sid}"
}

cmd_move() {
  if [[ "$HAS_V2" == 2 ]]; then
    echo "Error: move is not supported for v2 or mixed OpenCode databases. Move sessions through OpenCode instead." >&2
    exit 1
  fi
  local apply=0
  local dry_run=0
  local positionals=()

  while [[ $# -gt 0 ]]; do
    case "$1" in
      --apply)
        apply=1
        shift
        ;;
      --dry-run)
        dry_run=1
        shift
        ;;
      -h|--help)
        echo "Usage: sesh move <session_id> <target-project-dir> [--dry-run|--apply]"
        exit 0
        ;;
      -* )
        echo "Error: Unknown option: $1" >&2
        exit 1
        ;;
      *)
        positionals+=("$1")
        shift
        ;;
    esac
  done

  if (( apply && dry_run )); then
    echo "Error: use only one of --dry-run or --apply" >&2
    exit 1
  fi

  if [[ "${#positionals[@]}" -ne 2 ]]; then
    echo "Error: move requires a session ID and target project directory" >&2
    echo "Usage: sesh move <session_id> <target-project-dir> [--dry-run|--apply]" >&2
    exit 1
  fi

  ensure_project_worktree_column

  local sid="${positionals[0]}"
  local target_dir="${positionals[1]}"
  local escaped_sid
  escaped_sid="$(escape_sql "$sid")"
  ensure_session_exists "$escaped_sid"

  target_dir="$(resolve_path "$target_dir")"
  local escaped_target_dir
  escaped_target_dir="$(escape_sql "$target_dir")"

  local target_count
  target_count=$(sqlite3 "$DB" "SELECT count(*) FROM project WHERE worktree = '${escaped_target_dir}';" 2>/dev/null)
  if [[ "$target_count" -eq 0 ]]; then
    echo "Error: target project not found in OpenCode database: ${target_dir}" >&2
    echo "Open the target directory in OpenCode once, then retry." >&2
    exit 1
  fi
  if [[ "$target_count" -gt 1 ]]; then
    echo "Error: multiple OpenCode projects match target directory: ${target_dir}" >&2
    exit 1
  fi

  local current_row
  current_row=$(sqlite3 -separator $'\t' "$DB" "
    SELECT s.project_id, s.directory
    FROM session s
    WHERE s.id = '${escaped_sid}';
  ")

  local current_project_id current_dir
  IFS=$'\t' read -r current_project_id current_dir <<< "$current_row"

  local target_row
  target_row=$(sqlite3 -separator $'\t' "$DB" "
    SELECT id, worktree
    FROM project
    WHERE worktree = '${escaped_target_dir}';
  ")

  local target_project_id target_worktree
  IFS=$'\t' read -r target_project_id target_worktree <<< "$target_row"

  if [[ "$current_project_id" == "$target_project_id" && "$current_dir" == "$target_worktree" ]]; then
    echo "Error: session is already in target project: ${target_worktree}" >&2
    exit 1
  fi

  echo "Move session ${sid}"
  echo ""
  echo "Current:"
  echo "  project_id: ${current_project_id}"
  echo "  directory:   ${current_dir}"
  echo ""
  echo "Target:"
  echo "  project_id: ${target_project_id}"
  echo "  directory:   ${target_worktree}"

  if (( ! apply )); then
    echo ""
    echo "No changes written. Re-run with --apply to update."
    return
  fi

  local backup
  backup="$(create_db_backup)"

  local escaped_target_project_id escaped_target_worktree now_ms changes
  escaped_target_project_id="$(escape_sql "$target_project_id")"
  escaped_target_worktree="$(escape_sql "$target_worktree")"
  now_ms=$(( $(date +%s) * 1000 ))

  changes=$(sqlite3 "$DB" "
    BEGIN IMMEDIATE;
    UPDATE session
    SET project_id = '${escaped_target_project_id}',
        directory = '${escaped_target_worktree}',
        time_updated = ${now_ms}
    WHERE id = '${escaped_sid}';
    SELECT changes();
    COMMIT;
  " 2>/dev/null)

  if [[ "$changes" != "1" ]]; then
    echo "Error: expected to update 1 session row, updated ${changes:-0}" >&2
    exit 1
  fi

  echo ""
  echo "Backup created: ${backup}"
  echo "Moved session ${sid}"
  echo "  project_id: ${current_project_id} -> ${target_project_id}"
  echo "  directory:   ${current_dir} -> ${target_worktree}"
}

cmd_today() {
  local verbose=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose) verbose=1; shift;;
      -h|--help)
        echo "Usage: sesh today [--verbose]"
        exit 0
        ;;
      *)
        echo "Error: Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  local session_filter
  session_filter="$(session_filter_clause s "$verbose")"
  read_db -header -column "
    SELECT id, directory, title, datetime(time_created/1000,'unixepoch') as created, datetime(time_updated/1000,'unixepoch') as updated
    FROM session s
    WHERE s.time_updated > (strftime('%s','now') - 86400) * 1000
      AND ${session_filter}
    ORDER BY s.time_updated DESC
    LIMIT 20;
  "
}

cmd_stats() {
  local verbose=0
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --verbose) verbose=1; shift;;
      -h|--help)
        echo "Usage: sesh stats [--verbose]"
        exit 0
        ;;
      *)
        echo "Error: Unknown option: $1" >&2
        exit 1
        ;;
    esac
  done

  local session_filter
  session_filter="$(session_filter_clause s "$verbose")"

  echo "Session statistics"

  read_db -separator $'\n' "
    WITH filtered_sessions AS (
      SELECT * FROM session s WHERE ${session_filter}
    )
    SELECT 'Total sessions:      ' || count(*) FROM filtered_sessions
    UNION ALL
    SELECT 'Total messages:      ' || count(*)
    FROM message m
    WHERE EXISTS (SELECT 1 FROM filtered_sessions s WHERE s.id = m.session_id)
    UNION ALL
    SELECT 'Total projects:      ' || count(DISTINCT project_id) FROM filtered_sessions
    UNION ALL
    SELECT 'Total directories:   ' || count(DISTINCT directory) FROM filtered_sessions;
  "

  echo ""
  echo "Date range"
  read_db -separator $'\n' "
    WITH filtered_sessions AS (
      SELECT * FROM session s WHERE ${session_filter}
    )
    SELECT 'Earliest:   ' || datetime(MIN(time_created)/1000,'unixepoch') FROM filtered_sessions
    UNION ALL
    SELECT 'Latest:     ' || datetime(MAX(time_created)/1000,'unixepoch') FROM filtered_sessions;
  "

  echo ""
  echo "Top directories"
  read_db -separator $'\n' "
    SELECT '  ' || printf('%3d', cnt) || ' ' || dir || ''
    FROM (
      SELECT directory as dir, count(*) as cnt
      FROM session s
      WHERE ${session_filter}
      GROUP BY directory
      ORDER BY cnt DESC
      LIMIT 10
    );
  "

  echo ""
  echo "Token usage (all time)"
  read_db -separator $'\n' "
    SELECT 'Total cost:       ' || printf('%.4f', COALESCE(SUM(cost), 0))
    FROM session s WHERE ${session_filter}
    UNION ALL
    SELECT 'Total input tokens: ' || COALESCE(SUM(tokens_input), 0)
    FROM session s WHERE ${session_filter}
    UNION ALL
    SELECT 'Total output tokens:' || COALESCE(SUM(tokens_output), 0)
    FROM session s WHERE ${session_filter}
    UNION ALL
    SELECT 'Total reasoning tokens:' || COALESCE(SUM(tokens_reasoning), 0)
    FROM session s WHERE ${session_filter};
  "
}

cmd_files() {
  local sid="$1"
  if [[ -z "$sid" ]]; then
    echo "Error: files requires a session ID" >&2
    exit 1
  fi
  sid="$(escape_sql "$sid")"
  ensure_session_exists "$sid"

  local file_count
  file_count=$(read_db "
    SELECT count(DISTINCT file) FROM session_file WHERE session_id = '${sid}';
  " 2>/dev/null)

  if [[ "$file_count" -gt 0 ]]; then
    echo "Files touched in ${sid}:"
    echo ""
    read_db -separator $'\n' "
      SELECT DISTINCT file FROM session_file WHERE session_id = '${sid}' ORDER BY file;
    " 2>/dev/null | while IFS= read -r f; do
      if [[ -n "$f" ]]; then
        echo "- $f"
      fi
    done
  else
    echo "No file diffs found in session ${sid}"
  fi
}

cmd_config() {
  local sesh_path
  sesh_path="$(realpath "$0" 2>/dev/null || echo "$0")"

  echo "sesh configuration"
  echo "Binary:     ${sesh_path}"
  echo "Database:   ${DB}"
  echo ""
  echo "Environment:"
  if [[ -n "${OPENCODE_DB:-}" ]]; then
    echo "  OPENCODE_DB    ${OPENCODE_DB}  (explicit)"
  else
    echo "  OPENCODE_DB    (not set - using default)"
  fi
  if [[ -n "${SESH_BIN:-}" ]]; then
    echo "  SESH_BIN      ${SESH_BIN}  (explicit)"
  else
    echo "  SESH_BIN      (not set - plugin uses \$HOME/.local/bin/sesh)"
  fi
  echo ""
  echo "Tips:"
  echo "- Set OPENCODE_DB to use a different SQLite database"
  echo "- Set SESH_BIN for the plugin to find sesh in nonstandard locations"
}

cmd="${1:-list}"
shift 2>/dev/null || true

case "$cmd" in
  list)       cmd_list "$@";;
  search)     cmd_search "$@";;
  index)      cmd_index "$@";;
  show)       cmd_show "${1:-}";;
  log)        cmd_messages log "${1:-}" "${@:2}";;
  prompts)    cmd_messages prompts "${1:-}" "${@:2}";;
  resume)     cmd_resume "${1:-}";;
  move)       cmd_move "$@";;
  files)      cmd_files "${1:-}";;
  config)     cmd_config;;
  today)      cmd_today "$@";;
  stats)      cmd_stats "$@";;
  help|--help|-h) usage; exit 0;;
  *)
    echo "Error: Unknown command '$cmd'" >&2
    usage >&2
    exit 1
    ;;
esac
