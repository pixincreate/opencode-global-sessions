{
  "name": "opencode-global-sessions",
  "version": "3.0.2",
  "description": "Global session search for OpenCode",
  "exports": {
    "./tui": "./dist/tui.js"
  },
  "type": "module",
  "scripts": {
    "build": "node build.mjs",
    "typecheck": "tsc --noEmit",
    "prepack": "npm run build",
    "release": "bash scripts/release.sh",
    "shellcheck": "shellcheck sesh test/e2e.sh scripts/install.sh scripts/release.sh",
    "test": "bash test/e2e.sh",
    "check": "npm run shellcheck && npm run typecheck && npm run build && npm test"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.5.10",
    "@opentui/solid": ">=0.5.10",
    "solid-js": ">=1.9.0"
  },
  "devDependencies": {
    "@opencode-ai/plugin": "^1.19.6",
    "@opencode/plugin": "^2.4.1",
    "@opentui/core": "^0.9.9",
    "@opentui/solid": "^0.9.9",
    "@types/node": "^26.6.10",
    "esbuild": "^0.28.2",
    "solid-js": "1.9.12",
    "typescript": "^7.0.2"
  },
  "files": [
    "dist/tui.js",
    "dist/tui.js.map",
    "sesh"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pixincreate/opencode-global-sessions.git"
  },
  "keywords": [
    "opencode",
    "session",
    "search"
  ],
  "license": "MIT",
  "overrides": {
    "seroval": "1.8.1",
    "seroval-plugins": "1.8.0",
    "effect": "4.1.0",
    "zod": "4.6.7"
  }
}
